# Names of settings the site needs, never their values. Real values go in .env,
# which never leaves your computer.

# Supabase project URL. Public: it ends up in the site's files.
VITE_SUPABASE_URL=
# Supabase publishable key (starts sb_publishable_). Public: made for browsers.
VITE_SUPABASE_PUBLISHABLE_KEY=
